# Public browser configuration. Never place a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Leave both blank for the normal same-origin setup. In local development Vite
# proxies /api and /health to DEV_API_TARGET. Docker uses the same URL layout.
VITE_API_URL=
VITE_INTERVIEW_API_URL=
DEV_API_TARGET=http://127.0.0.1:8000

# Public Jitsi as a Service application identifier.
VITE_JAAS_APP_ID=vpaas-magic-cookie-1fe1890c22f1421fb11848cbf09f62e7
